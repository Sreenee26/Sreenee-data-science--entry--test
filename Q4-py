def string_reverse(s):
    """
    Task 1:
    - Reverse a given string
    - s must be a string
    - Return the reversed string
    """

    # Check if input is a string
    if not isinstance(s, str):
        return -1

    # Reverse the string
    reversed_string = s[::-1]

    return reversed_string


# Task 2: Test cases
print(string_reverse("Hello World"))
print(string_reverse("Python"))
