def find_first_negative(lst):
    """
    Task 1:
    - Find the first negative number in a list
    - Use while loop
    - Return the number if found, else "No negatives"
    """

    # Check if input is a list
    if not isinstance(lst, list):
        return -1

    i = 0

    # Loop using while
    while i < len(lst):
        if lst[i] < 0:
            return lst[i]
        i += 1

    return "No negatives"


# Task 2: Test cases
print(find_first_negative([3, 5, -1, 7, -2, 8]))
print(find_first_negative([2, 10, 7, 0]))
