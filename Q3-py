def update_dictionary(dct, key, value):
    """
    Task 1:
    - Update dictionary with key-value pair
    - If key exists, print original value, then update
    - Return updated dictionary
    """

    # Check if input is a dictionary
    if not isinstance(dct, dict):
        return -1

    # If key exists, print original value
    if key in dct:
        print("Original value:", dct[key])

    # Update or add key-value pair
    dct[key] = value

    return dct


# Task 2: Test cases
print(update_dictionary({}, "name", "Alice"))
print(update_dictionary({"age": 25}, "age", 26))
